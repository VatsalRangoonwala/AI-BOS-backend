# Local-development values only. Use a secret manager and unique credentials outside local development.
APP_ENV=local
LOG_LEVEL=debug

HTTP_ADDR=:8080
FRONTEND_ORIGINS=http://localhost:3000
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=20s
HTTP_IDLE_TIMEOUT=60s
HTTP_REQUEST_TIMEOUT=15s
HTTP_SHUTDOWN_TIMEOUT=15s
HTTP_MAX_BODY_BYTES=1048576

POSTGRES_USER=aibos
POSTGRES_PASSWORD=aibos_local
POSTGRES_DB=aibos
POSTGRES_PORT=5432
DATABASE_URL=postgres://aibos:aibos_local@localhost:5432/aibos?sslmode=disable
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_CONNECT_TIMEOUT=5s
DB_HEALTH_TIMEOUT=2s
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
REDIS_DIAL_TIMEOUT=3s
REDIS_READ_TIMEOUT=2s
REDIS_WRITE_TIMEOUT=2s
REDIS_HEALTH_TIMEOUT=2s

WORKER_HEALTH_INTERVAL=30s
